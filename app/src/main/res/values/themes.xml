<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SplashImagenApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/azul_fondo</item>
        <item name="android:navigationBarColor">@color/azul_fondo</item>
    </style>

    <style name="Theme.SplashImagenApp.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/azul_fondo</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo</item>
        <item name="postSplashScreenTheme">@style/Theme.SplashImagenApp</item>
    </style>

</resources>